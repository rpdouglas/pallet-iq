{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\" && python3 .claude/hooks/git-branch-guard.py",
            "statusMessage": "Checking branch guard..."
          }
        ]
      }
    ]
  }
}
