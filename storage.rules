rules_version = '2';

// PalletIQ Cloud Storage security rules — Phase 0 scaffold.
//
// Applies the same tenant-isolation principle as firestore.rules (see
// docs/adr/0001-multi-tenant-from-phase-0.md): every tenant-owned object lives
// under tenants/{tenantId}/... and is gated by isTenantMember(tenantId).
//
// Default posture: any authenticated member of the tenant may read/write within
// their own tenant's folder — a safe-by-default starting point, not a final
// policy. Tighten per-path (e.g. read-only for Warehouse on cost-adjacent
// documents) as each upload flow (manifest files, PALLETIQ-008; images) is
// actually implemented and its real RBAC needs are known.
//
// storage.rules.test.ts (Storage emulator + @firebase/rules-unit-testing)
// covers this file, mirroring firestore.rules.test.ts's governance Check I
// tenant-isolation pattern - added PALLETIQ-001, expanded PALLETIQ-008/012.

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isTenantMember(tenantId) {
      return isSignedIn() && request.auth.token.tenantId == tenantId;
    }

    function tokenRole() {
      return request.auth.token.role;
    }

    // PALLETIQ-008 / ADR-0006. The raw manifest file has unitCost as a
    // plain column, so it must not bypass lineItems' UI-level cost-field
    // omission for Warehouse (firestore.rules) - read is Owner/Manager/
    // Buyer, write is Owner/Buyer, matching firestore.rules' isOwnerOrBuyer
    // for imports/manifests. This has to be its own match block *and* the
    // blanket rule below has to explicitly exclude manifests/ (see its
    // comment) - Storage Security Rules union every matching block, so a
    // permissive catch-all would silently re-grant what this block denies
    // otherwise.
    match /tenants/{tenantId}/manifests/{importId}/{fileName} {
      allow read: if isTenantMember(tenantId) && tokenRole() in ['owner', 'manager', 'buyer'];
      // PALLETIQ-012 / ADR-0008. The real size-limit enforcement point -
      // matches functions/src/manifests/processManifestImport.ts's
      // MAX_FILE_SIZE_BYTES, kept in sync via this comment on both sides.
      // Split from `delete` (below) because request.resource is null on a
      // delete, so a single `allow write` referencing request.resource.size
      // would make deletes impossible.
      allow create, update: if isTenantMember(tenantId) &&
        tokenRole() in ['owner', 'buyer'] &&
        request.resource.size < 10 * 1024 * 1024;
      allow delete: if isTenantMember(tenantId) && tokenRole() in ['owner', 'buyer'];
    }

    // PALLETIQ-025 / ADR-0011. Buyer's pre-purchase capture photos - unlike
    // manifests (raw cost data), a photo of an item isn't cost-sensitive,
    // so every tenant member can read it; write (create/update/delete) is
    // Owner/Buyer only, matching firestore.rules' isOwnerOrBuyer for
    // item_scans. Same 10 MB per-file size-limit posture as ADR-0008.
    match /tenants/{tenantId}/item_scans/{scanId}/{fileName} {
      allow read: if isTenantMember(tenantId);
      allow create, update: if isTenantMember(tenantId) &&
        tokenRole() in ['owner', 'buyer'] &&
        request.resource.size < 10 * 1024 * 1024;
      allow delete: if isTenantMember(tenantId) && tokenRole() in ['owner', 'buyer'];
    }

    // Excludes manifests/ and item_scans/ (each handled above with its own
    // tighter policy) - see those blocks' comments for why this exclusion
    // is required, not optional. Storage Rules has no string .matches()/
    // regex support (unlike Firestore rules), so the exclusion is done
    // structurally: capture the first path segment on its own and compare
    // it directly, rather than pattern-match the full remaining path.
    match /tenants/{tenantId}/{firstSegment}/{rest=**} {
      allow read, write: if isTenantMember(tenantId) &&
        firstSegment != 'manifests' &&
        firstSegment != 'item_scans';
    }

    // Deny-by-default for anything not explicitly matched above.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
